# =============================================================================
# F1 handover (rfsim) scenario — environment
#
# Topology: 1 CU + 2 DUs + 1 UE, all rfsim. The UE is the rfsim SERVER; both
# DUs are rfsim clients that dial it (role inversion — required because rfsim
# allows only one server with many clients, and the UE must hear both DUs).
# Handover is triggered manually over telnet: see start_handover.sh / README.md.
# =============================================================================

# Core network config (reuses the project core, unchanged — F1 HO is intra-CU,
# so there is a single NG connection CU<->AMF).
SYSTEM_CONFIG="../common/sys_config.yaml"

CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-log

# =============================================================================
# Image Tags
# =============================================================================

GNB_IMAGE=oai-gnb-cuda
UE_IMAGE=oai-nr-ue-cuda

GNB_TAG=latest
UE_TAG=latest
AMF_TAG=v2.1.10
SMF_TAG=v2.1.10
UPF_TAG=v2.1.10
TRFGEN_TAG=latest

# =============================================================================
# Thread pools — each PHY instance (both DUs and the UE) needs its own cores.
# Split the gNB core range across the two DUs so they don't contend. Adjust to
# your host. (The CU has no PHY, so it gets no thread pool.)
# =============================================================================

DU0_THREAD_POOL="--thread-pool ${SRK_DU0_THREAD_POOL:-6,7,8}"
DU1_THREAD_POOL="--thread-pool ${SRK_DU1_THREAD_POOL:-9,10,11}"
UE_THREAD_POOL="--thread-pool ${SRK_UE_THREAD_POOL:-3,4}"

# =============================================================================
# UE radio parameters. -C is the DL center frequency the UE tunes to at start;
# it matches DU0's SSB (641280 = 3619.2 MHz), so the UE first camps on DU0.
# =============================================================================

UE_RADIO_OPTIONS="-r 106 --numerology 1 -C 3619200000 --ssb 516"

# =============================================================================
# B200/USRP — off (this is a pure rfsim scenario).
# =============================================================================

USE_B2XX=no
