#!/bin/bash
# Auto-maintain the AUTO:files region of AINL.md before each commit, and keep
# the English/Korean document pairs (scripts/README.md + scripts/README.ko.md,
# AINL.md + AINL.ko.md) in sync.
repo="$(git rev-parse --show-toplevel)"

# Block the commit if either file of a pair is staged and the staged pair
# differs in structure. Bypass with `git commit --no-verify`.
check="$repo/scripts/check-readme-sync.sh"
check_pair() {
    local en="$1" ko="$2"
    local staged
    staged="$(git diff --cached --name-only -- "$en" "$ko")"
    [ -n "$staged" ] && [ -x "$check" ] || return 0
    local tmp rc
    tmp="$(mktemp -d)"
    git show ":$en" > "$tmp/${en##*/}" 2>/dev/null
    git show ":$ko" > "$tmp/${ko##*/}" 2>/dev/null
    "$check" "$tmp/${en##*/}" "$tmp/${ko##*/}"
    rc=$?
    rm -rf "$tmp"
    [ "$rc" -eq 1 ] && return 1
    if [ "$(printf '%s\n' "$staged" | wc -l)" -eq 1 ]; then
        echo "note: only $staged is staged; update the other language too if the prose changed." >&2
    fi
    return 0
}
check_pair scripts/README.md scripts/README.ko.md || exit 1
check_pair AINL.md AINL.ko.md || exit 1

gen="$repo/scripts/update-ainl.sh"
[ -x "$gen" ] || exit 0
"$gen" >/dev/null 2>&1 || exit 0      # never block a commit on generator errors
git add "$repo/AINL.md" "$repo/AINL.ko.md" 2>/dev/null || true
exit 0
